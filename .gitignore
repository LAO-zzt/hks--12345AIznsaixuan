# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
venv312/
env/

# 输出结果（每次运行重新生成，不入库）
data/output/

# 解析缓存（大文件首次解析后落地，体积大不入库）
*.pkl

# 真实数据大文件不入库（仅内置 sample.csv 入库）
data/input/*.xlsx
data/input/*.xlsm

# 本地模型（体积大，不入库）
models/

# 环境与密钥
.env
*.log
webapp/secrets.json
textclean_module/config.yaml

# 隐私文件（凭证/工单数据/清洗库/临时文件）严禁入库
密钥/
data/feishu_cache.parquet
data/input/*.csv
textclean_module/data/*.db
textclean_module/data/*.db-shm
textclean_module/data/*.db-wal
_tmp_*.py
_backup_*.html
tests/textclean_module/

# IDE
.idea/
.vscode/
